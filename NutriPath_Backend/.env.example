PORT=8080
HOST=127.0.0.1
CORS_ORIGIN=http://127.0.0.1:5173
NUTRIPATH_DB=./data/db.json
NUTRIPATH_DATA_SOURCE=json
NUTRIPATH_SQL_SERVER=localhost
NUTRIPATH_SQL_DATABASE=NutriPath
NUTRIPATH_SQL_TRUST_CERT=false

SUPABASE_DATABASE_URL=
SUPABASE_DATABASE_SSL=true
SUPABASE_DATABASE_SSL_REJECT_UNAUTHORIZED=false
SUPABASE_DATABASE_POOL_MAX=5

# Supabase production data storage:
# - normalized: writes NutriPath data into separate PostgreSQL tables.
# - app_state/jsonb/legacy: old single-row JSONB adapter, useful only for fallback.
NUTRIPATH_SUPABASE_STORAGE=normalized
NUTRIPATH_SUPABASE_SCHEMA=public
# Legacy app_state table. In normalized mode this is read once as a migration source
# when the normalized tables are empty.
NUTRIPATH_SUPABASE_TABLE=public.nutripath_app_state
NUTRIPATH_SUPABASE_STATE_KEY=default

# Supabase Auth verification for Google/Facebook OAuth
# Keep this in backend env too so /api/auth/supabase can validate access tokens.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_AUTH_TIMEOUT_MS=10000
# Alternative name for Supabase's new publishable key format (sb_publishable_...)
SUPABASE_PUBLISHABLE_KEY=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RPM_LIMIT=5
GEMINI_RPD_LIMIT=20
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_RPM_LIMIT=30
GROQ_RPD_LIMIT=1000
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.6
KIMI_RPM_LIMIT=30
KIMI_RPD_LIMIT=1000
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_RPM_LIMIT=30
DEEPSEEK_RPD_LIMIT=1000
AI_SLOT3_NAME=ai-slot-3
AI_SLOT3_API_KEY=
AI_SLOT3_BASE_URL=https://openrouter.ai/api/v1
AI_SLOT3_MODEL=
AI_SLOT3_RPM_LIMIT=30
AI_SLOT3_RPD_LIMIT=1000
# Optional internal override key for chat safety rules. Keep the real value only in backend .env/deploy env.
CHAT_ADMIN_KEY=
